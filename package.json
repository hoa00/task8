{
  "name": "task8",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint apps packages tests/workspace tests/contracts tests/data tests/visual/foundation tests/visual/controls tests/visual/overlays tests/visual/shell tests/visual/tasks tests/visual/task-list tests/visual/task-detail tests/visual/task-board tests/visual/calendar tests/visual/timeline tests/visual/task-table tests/visual/task-collaboration eslint.config.mjs && node tests/workspace/boundaries.mjs",
    "test": "turbo run test && pnpm test:reference && pnpm test:workspace",
    "test:reference": "node --test tests/visual/reference/*.test.mjs",
    "test:workspace": "node --test tests/workspace/*.test.mjs",
    "reference:check": "node tests/visual/reference/source-check.mjs",
    "reference:bootstrap-assets": "node tests/visual/reference/bootstrap-assets.mjs",
    "visual:reference:capture": "node tests/visual/reference/capture.mjs capture",
    "visual:reference:verify": "node tests/visual/reference/capture.mjs verify",
    "visual:reference:probes": "node tests/visual/reference/interaction-probes.mjs",
    "visual:reference:review": "node tests/visual/reference/review-sheets.mjs",
    "visual:compare": "node tests/visual/reference/compare.mjs",
    "visual:reference:smoke": "node tests/visual/reference/capture.mjs smoke",
    "workspace:graph": "turbo run build --dry=json",
    "api:types": "pnpm --filter @studio/api types",
    "workspace:verify": "node tests/workspace/artifacts.mjs",
    "test:contracts": "pnpm --filter @studio/contracts test",
    "contracts:coverage": "pnpm --filter @studio/contracts test:coverage",
    "contracts:consumers": "pnpm --filter @studio/contracts typecheck:consumers",
    "visual:foundation": "node tests/visual/foundation/verify.mjs",
    "visual:controls": "node tests/visual/controls/verify.mjs",
    "foundation:audit": "node tests/visual/foundation/audit.mjs",
    "visual:overlays": "node tests/visual/overlays/verify.mjs",
    "test:overlays:lifecycle": "node tests/visual/overlays/lifecycle.mjs",
    "visual:overlays:motion": "node tests/visual/overlays/motion.mjs",
    "test:data": "pnpm --filter @studio/web test",
    "verify:data:http-bundle": "pnpm --filter @studio/web build:http && node tests/data/http-bundle.mjs",
    "verify:data": "node tests/data/verify.mjs",
    "visual:shell": "node tests/visual/shell/verify.mjs",
    "test:shell:routes": "node tests/visual/shell/routes.mjs",
    "verify:shell": "node tests/visual/shell/gates.mjs",
    "visual:task-fields": "node tests/visual/tasks/verify.mjs",
    "test:task-fields:interactions": "node tests/visual/tasks/interactions.mjs",
    "visual:task-list": "node tests/visual/task-list/verify.mjs",
    "test:task-list:interactions": "node tests/visual/task-list/interactions.mjs",
    "verify:task-list": "node tests/visual/task-list/gates.mjs",
    "visual:task-detail": "node tests/visual/task-detail/verify.mjs",
    "test:task-detail:interactions": "node tests/visual/task-detail/interactions.mjs",
    "verify:task-detail": "node tests/visual/task-detail/gates.mjs",
    "visual:task-collaboration": "node tests/visual/task-collaboration/verify.mjs",
    "test:task-collaboration:interactions": "node tests/visual/task-collaboration/interactions.mjs",
    "test:task-collaboration:editor-drop": "node tests/visual/task-collaboration/editor-drop.mjs",
    "test:task-collaboration:editor": "node tests/visual/task-collaboration/interactions.mjs --editor-only",
    "verify:task-collaboration": "node tests/visual/task-collaboration/gates.mjs",
    "visual:task-board": "node tests/visual/task-board/verify.mjs",
    "test:task-board:interactions": "node tests/visual/task-board/interactions.mjs",
    "test:task-board:m1": "node tests/visual/task-board/journey.mjs",
    "verify:task-board": "node tests/visual/task-board/gates.mjs",
    "visual:task-table": "node tests/visual/task-table/verify.mjs",
    "test:task-table:interactions": "node tests/visual/task-table/interactions.mjs",
    "verify:task-table": "node tests/visual/task-table/gates.mjs",
    "visual:calendar": "node tests/visual/calendar/verify.mjs",
    "test:calendar:interactions": "node tests/visual/calendar/interactions.mjs",
    "verify:calendar": "node tests/visual/calendar/gates.mjs",
    "visual:timeline": "node tests/visual/timeline/verify.mjs",
    "test:timeline:interactions": "node tests/visual/timeline/interactions.mjs",
    "verify:timeline": "node tests/visual/timeline/gates.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
