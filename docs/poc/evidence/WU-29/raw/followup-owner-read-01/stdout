export interface FileCardProps { file: FileDto; author?: MemberDisplayDto; now: string; onPreview: (file: FileDto) => void; onMenu: (file: FileDto, anchor: HTMLElement, point?: OverlayPoint) => void }
export function FileCard({ file, author, now, onPreview, onMenu }: FileCardProps) { return <div data-file-card={file.id} role="button" tabIndex={0} aria-label={`Preview ${file.name}`} className="group relative cursor-pointer overflow-hidden rounded-lg border border-solid border-border bg-surface text-left transition-[border-color] source-hover:border-border-strong" onClick={() => onPreview(file)} onKeyDown={event => { if (event.target === event.currentTarget && ['Enter', ' '].includes(event.key)) { event.preventDefault(); onPreview(file); } }} onContextMenu={event => { event.preventDefault(); onMenu(file, event.currentTarget, { x: event.clientX, y: event.clientY }); }}><FilePreviewArt name={file.name} type={file.fileType}/><div className="flex flex-col gap-[2px] px-[10px] py-[9px]"><span className="truncate text-sm font-medium">{file.name}</span><span className="text-[11px] text-muted">{file.displaySize} · {author?.name.split(' ')[0]} · {ago(file.createdAt, now)}</span></div><IconButton size="xs" aria-label={`File options ${file.name}`} className="absolute! top-[6px] right-[6px] bg-surface opacity-0 [box-shadow:0_0_0_1px_var(--border)] group-hover:opacity-100 focus-visible:opacity-100" onClick={event => { event.stopPropagation(); onMenu(file, event.currentTarget); }}><Icon name="ellipsis" size={13}/></IconButton></div>; }
export interface FileRowProps extends FileCardProps { task?: TaskDto; onTaskOpen: (id: string) => void }
export function FileRow({ file, author, now, task, onPreview, onMenu, onTaskOpen }: FileRowProps) { return <tr data-file-row={file.id} onContextMenu={event => { event.preventDefault(); onMenu(file, event.currentTarget, { x: event.clientX, y: event.clientY }); }}><td className="pl-[14px]!"><span className="flex items-center gap-2"><FileTypeIcon type={file.fileType}/><button className="font-medium text-left" onClick={() => onPreview(file)}>{file.name}</button>{task && <button className="inline-flex" onClick={() => onTaskOpen(task.id)}><Badge><Icon name="link" size={10}/>{task.key}</Badge></button>}</span></td><td className="text-left! text-secondary">{(fileTypeCatalog[file.fileType] ?? fileTypeCatalog.other!).name}</td><td className="text-left! tabular-nums text-secondary">{file.displaySize}</td><td className="text-left!"><span className="flex items-center gap-2"><MemberIdentity member={author ?? null} className="static!" nameClassName=""/></span></td><td className="text-left! text-secondary">{ago(file.createdAt, now)}</td><td><IconButton size="sm" aria-label={`File options ${file.name}`} onClick={event => onMenu(file, event.currentTarget)}><Icon name="ellipsis" size={14}/></IconButton></td></tr>; }
export interface FileCatalogueProps { files: readonly FileDto[]; members: readonly MemberDisplayDto[]; tasks: readonly TaskDto[]; mode: 'grid' | 'list'; now: string; onPreview: FileCardProps['onPreview']; onMenu: FileCardProps['onMenu']; onTaskOpen: FileRowProps['onTaskOpen'] }
export function FileCatalogue({ files, members, tasks, mode, now, onPreview, onMenu, onTaskOpen }: FileCatalogueProps) { const props = (file: FileDto): FileCardProps => ({ file, ...(members.find(member => member.id === file.createdBy) ? { author: members.find(member => member.id === file.createdBy)! } : {}), now, onPreview, onMenu }); return mode === 'grid' ? <div data-file-grid className="grid grid-cols-[repeat(auto-fill,minmax(180px,1fr))] gap-3">{files.map(file => <FileCard key={file.id} {...props(file)}/>)}</div> : <Panel className="overflow-x-auto" data-file-list><table className="file-table min-w-[680px]"><thead><tr>{['Name', 'Type', 'Size', 'Uploaded by', 'Date', ''].map((name, index) => <th key={index} className={index === 0 ? 'pl-[14px]!' : index < 5 ? 'text-left!' : ''}>{name}</th>)}</tr></thead><tbody>{files.map(file => <FileRow key={file.id} {...props(file)} {...(tasks.find(task => task.id === file.taskId) ? { task: tasks.find(task => task.id === file.taskId)! } : {})} onTaskOpen={onTaskOpen}/>)}</tbody></table></Panel>; }

