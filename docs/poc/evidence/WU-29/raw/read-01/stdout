/* ============================================================
   MOTION: one-shot flow animations (gated to the render they belong to)
   ============================================================ */
@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes slideInR {
  from {
    opacity: 0;
    transform: translateX(18px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes growX {
  from {
    transform: scaleX(0);
  }
}
@keyframes popCheck {
  0% {
    transform: scale(0.55);
  }
  55% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}
@keyframes strike {
  to {
    background-size: 100% 1.5px;
  }
}
@keyframes doneWash {
  from {
    background: var(--green-soft);
  }
  to {
    background: transparent;
  }
}
@keyframes doneRing {
  from {
    box-shadow:
      0 0 0 2px var(--green),
      var(--shadow-card);
  }
  to {
    box-shadow: var(--shadow-card);
  }
}
@keyframes land {
  0% {
    transform: scale(1.04) rotate(-1.2deg);
    box-shadow: var(--shadow-drag);
  }
  100% {
    transform: none;
    box-shadow: var(--shadow-card);
  }
}
@keyframes addWash {
  from {
    background: var(--accent-soft);
  }
  to {
    background: transparent;
  }
}
@keyframes addRing {
  from {
    box-shadow:
      0 0 0 2px var(--accent-line),
      var(--shadow-card);
  }
  to {
    box-shadow: var(--shadow-card);
  }
}
