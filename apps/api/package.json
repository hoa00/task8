{
  "name": "@studio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless api.datamaker-task wrangler dev --local --ip 127.0.0.1",
    "dev:direct": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime=false --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:reset:local": "node scripts/reset-local.mjs",
    "test:unit": "node --import ./tests/support/wasm-loader.mjs --experimental-transform-types --test tests/unit/*.test.mjs",
    "test:integration": "node --experimental-transform-types tests/run.mjs",
    "test": "pnpm test:unit && pnpm test:integration",
    "format": "prettier --write src tests/unit tests/integration tests/support tests/run.mjs tooling scripts drizzle.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src tests/unit tests/integration tests/support tests/run.mjs tooling scripts drizzle.config.ts tsconfig.json package.json .prettierrc.json",
    "lint": "eslint src tests/unit tests/integration tests/support tests/run.mjs tooling scripts drizzle.config.ts && node tooling/import-boundaries.mjs",
    "db:backfill:local": "node scripts/backfill-read-keys.mjs",
    "auth:link:local": "node --experimental-transform-types scripts/link-identity.mjs"
  },
  "dependencies": {
    "@hoa00/i24h-auth-honojs": "0.1.1",
    "@studio/contracts": "workspace:*",
    "@studio/domain": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "drizzle-kit": "0.31.11",
    "prettier": "3.6.2",
    "wrangler": "4.148.0"
  }
}
