{
  "name": "@studio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime=false --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:reset:local": "node scripts/reset-local.mjs",
    "test:d1": "node tests/runtime/verify.mjs",
    "test:wu31": "node tests/wu31/verify.mjs",
    "test:wu32": "node tests/wu32/verify.mjs",
    "test:wu33": "node tests/wu33/verify.mjs",
    "test:wu34": "node tests/wu34/verify.mjs",
    "test:wu35": "node tests/wu35/verify.mjs"
  },
  "dependencies": {
    "@studio/contracts": "workspace:*",
    "@studio/domain": "workspace:*",
    "hono": "4.13.13",
    "drizzle-orm": "0.45.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "drizzle-kit": "0.31.11",
    "wrangler": "4.148.0"
  }
}
