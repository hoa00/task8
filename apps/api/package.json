  "dependencies": {
    "@studio/contracts": "workspace:*",
    "@studio/domain": "workspace:*",
    "hono": "4.13.13",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "drizzle-kit": "0.31.11",
    "wrangler": "4.148.0"
  }
}
