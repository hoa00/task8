# Local ICT24H configuration for Wrangler. Copy to apps/api/.dev.vars.
# This template cannot authenticate until BOTH key placeholders are replaced.
# Obtain the RSA PUBLIC key from the operator of the actual ICT24H deployment.
# Do not generate your own RSA key for live login; do not put a private key here.
AUTH_MODE=ict24h
STUDIO_ENV=local
# Trusted fixture overrides retained for AUTH_MODE=local; ignored in ICT24H mode.
LOCAL_USER_ID=01a11abd-aa80-7d3f-879a-dd89204bcd77
LOCAL_WORKSPACE_ID=01a11abd-aa80-72ea-8b87-b31ad015a24e
AUTH_PROVIDER_KEY=ict24h-identity
AUTH_PROVIDER_BASE_URL=https://hrm-api-v2.cwr.i24h.app
AUTH_TENANT_ID=ict24h-rdn-dev
AUTH_APP_ORIGIN=https://datamaker-task.test:1355
AUTH_SESSION_MAX_AGE_SECONDS=1209600
AUTH_PUBLIC_KEY="REPLACE_WITH_COMPLETE_DEPLOYMENT_RSA_PUBLIC_PEM"
# Generate once: exactly 32 random bytes encoded as canonical base64url.
# Keep this key stable across restarts; rotating it invalidates old sessions.
AUTH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_SECRET

# Optional isolated OIDC deployment: choose AUTH_MODE=oidc explicitly.
# Preserve legacy values for rollback; OIDC never uses them as fallback.
# AUTH_APP_ORIGIN=https://datamaker-task.demo
# OIDC_ISSUER=https://identity-service.demo/api/auth
# OIDC_CLIENT_ID=REPLACE_WITH_REGISTERED_TASK8_CLIENT_ID
# OIDC_CLIENT_SECRET=REPLACE_WITH_PRIVATE_CLIENT_SECRET
# RP_ENVIRONMENT=local-if01
# RP_TOKEN_ENCRYPTION_KEYSET={"active":"key-1","keys":{"key-1":"REPLACE_WITH_CANONICAL_32_BYTE_BASE64URL_KEY"}}
